# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

NODE_ENV=development
PORT=8090
# true detrás de un proxy/load balancer, para que el límite de login vea la IP real
TRUST_PROXY=false
# Swagger UI en /docs y el documento en /docs/openapi.json
OPENAPI_ENABLED=true
# Cache-Control (segundos) en las respuestas del catálogo; 0 lo desactiva
CACHE_MAX_AGE_SECONDS=60
# Logs: json (producción, colectores de logs) o pretty (legible); nivel mínimo
LOG_FORMAT=pretty
LOG_LEVEL=log
# Métricas Prometheus en /metrics; con METRICS_TOKEN exige Authorization: Bearer <token>
METRICS_ENABLED=true
METRICS_TOKEN=
# Errores inesperados a Sentry (opcional)
SENTRY_DSN=
# Límite de peticiones por IP (ventana fija). postgres: compartido entre instancias
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=postgres
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
# Endpoints costosos: tarjetas PNG/SVG y autocompletado
RATE_LIMIT_HEAVY_MAX=60
# Tamaño máximo del body JSON (KB)
BODY_LIMIT_KB=100

# Catálogo de bebidas
#   snapshot:   el que siembran las migraciones (drizzle/0011). No llama a TheCocktailDB.
#   cocktaildb: se sincroniza con TheCocktailDB; necesita las variables COCKTAILDB_* de abajo
#               y, para producción, la clave Premium (ver README, "Datos de TheCocktailDB").
CATALOG_SOURCE=snapshot
# Imágenes de bebidas e ingredientes (archivos públicos; se usan en los dos modos)
COCKTAILDB_IMAGES_BASE_URL=https://www.thecocktaildb.com/images
# Solo con CATALOG_SOURCE=cocktaildb. "1" es la clave pública de pruebas.
COCKTAILDB_BASE_URL=
COCKTAILDB_API_KEY=
COCKTAILDB_TIMEOUT_MS=
COCKTAILDB_RETRIES=
COCKTAILDB_CRAWL_CONCURRENCY=
# Cada cuánto se resincroniza el catálogo (ms), p. ej. 21600000 = 6 h
CATALOG_TTL_MS=
# Cada cuánto cada instancia revisa si otra cambió el catálogo en caché (segundos)
CATALOG_CACHE_CHECK_SECONDS=30

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api-drinks-db
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10
# Aplica las migraciones pendientes al arrancar (seguro con varias réplicas)
MIGRATE_ON_START=false

# Autenticación. Genera el secreto con: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Orígenes del frontend permitidos por CORS (coma-separados, sin barra final)
CORS_ORIGINS=http://localhost:5173
# Cookie del refresh token. En producción con el frontend en otro dominio: none + true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# Opcional: compartir la cookie entre subdominios, p. ej. .midominio.com
REFRESH_COOKIE_DOMAIN=

# Límite de intentos de login: N fallos dentro de la ventana bloquean la cuenta o la IP
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Recuperar contraseña: página del frontend que recibe ?token=… y límites por email/IP
PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_ACCOUNT=3
PASSWORD_RESET_MAX_PER_IP=10
PASSWORD_RESET_WINDOW_SECONDS=3600

# Pagos. none: la API funciona sin pagos. wompi: Web Checkout de Wompi (llaves en comercios.wompi.co)
# Sandbox: llaves pub_test_/test_integrity_/test_events_ y WOMPI_API_URL=https://sandbox.wompi.co/v1
PAYMENTS_PROVIDER=none
SUBSCRIPTION_PERIOD_DAYS=30
PAYMENTS_REDIRECT_URL=http://localhost:5173/pago/resultado
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_TIMEOUT_MS=8000

# Correo. log: lo escribe en el log (desarrollo). smtp: lo envía con SMTP_*
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@api-drinks.local
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Cuenta admin opcional que se crea (o promueve) al arrancar. Las cuatro o ninguna.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_BIRTH_DATE=
