# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

NODE_ENV=development
PORT=8090
# true detrás de un proxy/load balancer, para que el límite de login vea la IP real
TRUST_PROXY=false
# Swagger UI en /docs y el documento en /docs/openapi.json
OPENAPI_ENABLED=true
# Cache-Control (segundos) en las respuestas del catálogo; 0 lo desactiva
CACHE_MAX_AGE_SECONDS=60

# TheCocktailDB (https://www.thecocktaildb.com/api.php). "1" es la clave pública de pruebas.
COCKTAILDB_BASE_URL=https://www.thecocktaildb.com/api/json/v1
COCKTAILDB_API_KEY=1
# Imágenes de bebidas e ingredientes
COCKTAILDB_IMAGES_BASE_URL=https://www.thecocktaildb.com/images
COCKTAILDB_TIMEOUT_MS=8000
COCKTAILDB_RETRIES=2
COCKTAILDB_CRAWL_CONCURRENCY=4
# Cada cuánto se resincroniza el catálogo (ms). 21600000 = 6 h
CATALOG_TTL_MS=21600000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api-drinks-db
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10

# Autenticación. Genera el secreto con: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Límite de intentos de login: N fallos dentro de la ventana bloquean la cuenta o la IP
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Cuenta admin opcional que se crea (o promueve) al arrancar. Las cuatro o ninguna.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_BIRTH_DATE=
